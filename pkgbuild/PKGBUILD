pkgname=cell
pkgver=0.2.0
pkgrel=1
pkgdesc='Local battery health and power consumption monitor for Omarchy'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/cell "$pkgdir/usr/bin/cell"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/cell.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/cell.svg"
  install -Dm644 "$startdir/cell.desktop" "$pkgdir/usr/share/applications/cell.desktop"
}
